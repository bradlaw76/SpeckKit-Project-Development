        "total": "5000+",
        "page": 1,
        "navigation": "Page arrows with page number"
      }
    }
  },

  // ------------------------------------------------------------
  // Right Pane – Copilot (AI Assistant)
  // ------------------------------------------------------------
  "rightPane": {
    "component": "Copilot",
    "icon": "Green sparkle",
    "purpose": "Get AI-powered help with solving customer issues.",
    "greeting": "Hi [UserName]\nDescribe what you need or select a suggestion to get started.",
    "tabs": [
      "Ask a question",
      "Write an email"
    ],
    "suggestedPrompts": [
      {
        "type": "Summarize",
        "icon": "Lines/List",
        "example": "Can you help summarize case [case number]?"
      },
      {
        "type": "Ask",
        "icon": "Chat bubble",
        "example": "Can you help me translate this content into English: '[content]'?"
      },
      {
        "type": "Discover",
        "icon": "Compass",
        "example": "Show me cases that have email updates in the last [3] days."
      }
    ],
    "viewPromptsLink": true,
    "inputArea": {
      "placeholder": "Describe what you need",
      "characterLimit": 2000,
      "characterCounter": "0 / 2000"
    },
    "footer": {
      "note": "Make sure AI-generated content is accurate and appropriate before using. Read term"
    }
  },

  // ------------------------------------------------------------
  // Layout Model
  // ------------------------------------------------------------
  "layout": {
    "structure": "Three-column",
    "columns": {
      "left": "Case stream navigation",
      "center": "Primary grid + toolbar",
      "right": "Copilot AI assistant panel"
    },
    "responsiveBehavior": {
      "leftPane": "Collapsible",
      "rightPane": "Docked / Toggleable",
      "grid": "Scrollable"
    }
  },

  // ------------------------------------------------------------
  // Functional Context
  // ------------------------------------------------------------
  "functionalPurpose": {
    "primaryUse": "Case management for contact center agents",
    "userRole": "Customer Service Representative",
    "coreTasks": [
      "View and manage active cases",
      "Filter and search cases",
      "Create new cases",
      "Collaborate and report",
      "Use Copilot for AI assistance"
    ]
  },

  // ------------------------------------------------------------
  // Reusable Component Patterns (Extractable)
  // ------------------------------------------------------------
  "reusablePatterns": {
    "threeColumnLayout": {
      "description": "Navigation pane | Main content area | AI assistant sidebar",
      "applicableTo": ["Case views", "Queue views", "Dashboard views"]
    },
    "dataverseGrid": {
      "description": "Standard Dynamics 365 grid with column sorting, filtering, inline visual badges, and alphabet filter bar",
      "applicableTo": ["Any entity list view"]
    },
    "copilotPanel": {
      "description": "Docked AI assistant with personalized greeting, suggested prompts, free-text input, and tab-based modes (Ask a question / Write an email)",
      "applicableTo": ["Any Dynamics 365 model-driven app with Copilot enabled"]
    },
    "caseStreamNav": {
      "description": "Vertical scrollable list of recent cases with category icons, status indicators, and item count footer",
      "applicableTo": ["Case management", "Activity management"]
    },
    "priorityBadges": {
      "description": "Color-coded priority indicators (Red triangle=High, Gray circle=Normal, Green square=Low)",
      "applicableTo": ["Any entity with priority field"]
    }
  }
}
