{
  // ============================================================
  // SpeckKit UI Reference
  // ID: dynamics365-contact-center-cases-grid
  // ============================================================
  // This is a reusable UI description model for the Dynamics 365
  // Contact Center workspace — Cases > My Active Cases grid view
  // with the Copilot AI assistant pane.
  //
  // Usage: Reference this file from any SpeckKit-governed project
  // to inherit UI patterns, layout models, and component specs
  // for Dynamics 365 Contact Center interfaces.
  //
  // Source Image: contact-center-cases-grid.png
  // Created: 2026-02-16
  // Last Updated: 2026-02-16
  // ============================================================

  "$schema": {
    "type": "SpeckKit.UIReference",
    "version": "1.1",
    "id": "dynamics365-contact-center-cases-grid",
    "name": "Dynamics 365 – Contact Center Cases Grid",
    "catalog": "ui-references",
    "platform": "dynamics365",
    "area": "ui",
    "registryUrl": "https://github.com/bradlaw76/SpeckKit-Project-Development/blob/main/ui-references/dynamics365/ui/contact-center-cases-grid.jsonc",
    "sourceImage": "contact-center-cases-grid.png",
    "created": "2026-02-16",
    "lastUpdated": "2026-02-16",
    "tags": [
      "dynamics-365",
      "contact-center",
      "case-management",
      "copilot",
      "grid-view",
      "customer-service"
    ]
  },

  // ============================================================
  // Application Context
  // ============================================================
  "app": {
    "platform": "Dynamics 365",
    "area": "Customer Service",
    "workspace": "Contact Center workspace",
    "environmentType": "Trial",
    "trialBanner": {
      "text": "Welcome to Contact Center trial",
      "action": "Open trial guide"
    },
    "theme": {
      "mode": "Light",
      "topBarColor": "#000000",
      "accentColor": "#00B7C3" // Teal accent in header icons
    }
  },

  // ------------------------------------------------------------
  // Global Header (Top Navigation Bar)
  // ------------------------------------------------------------
  "globalHeader": {
    "left": {
      "logo": "Dynamics 365",
      "appName": "Contact Center workspace"
    },
    "center": {
      "searchBar": {
        "placeholder": "Search",
        "scope": "Global"
      }
    },
    "right": {
      "icons": [
        "Lightbulb (Ideas)",
        "Create (+)",
        "Notifications (Bell)",
        "Settings (Gear)",
        "Help (?)",
        "Voice/Call Icon",
        "User Profile Avatar"
      ]
    }
  },

  // ------------------------------------------------------------
  // Secondary Header (App Context Bar)
  // ------------------------------------------------------------
  "contextBar": {
    "breadcrumb": [
      "Home"
    ],
    "tabs": [
      "Trial home",
      "Customer Service Representative",
      "Cases My Active Cases"
    ],
    "activeTab": "Cases My Active Cases",
    "tabBehavior": "Closable via X icon"
  },

  // ------------------------------------------------------------
  // Left Navigation Pane (Case Stream / Timeline)
  // ------------------------------------------------------------
  "leftPane": {
