      }
      // ...additional cases listed vertically (25 total)
    ],
    "footer": {
      "totalItems": 25,
      "lastUpdated": "10:41 AM"
    },
    "visualStyle": {
      "layout": "Vertical list",
      "icons": "Purple circular icons",
      "scrollable": true
    }
  },

  // ------------------------------------------------------------
  // Main Content Area (Cases Grid)
  // ------------------------------------------------------------
  "mainContent": {
    "viewName": "My Active Cases",
    "toolbar": {
      "actions": [
        "Show As",
        "Show Chart",
        "Inbox view",
        "New Case",
        "Delete",
        "Refresh",
        "Collaborate",
        "Run Report",
        "Share"
      ],
      "columnManagement": [
        "Edit columns",
        "Edit filters",
        "Filter by keyword"
      ]
    },

    "grid": {
      "type": "Dataverse View Grid",
      "columns": [
        "Case Title",
        "Case Number",
        "Priority",
        "Origin",
        "Customer",
        "Status Reason",
        "Created On"
      ],
